# このファイルを .env にコピーして使用します。.env は Git の追跡対象外です。
#
# .env に書いた値は、シェルの環境変数より優先されます。
# シェルに残った古い設定が意図せず使われるのを防ぐための仕様です。
# 一時的に切り替えたい場合は、コマンドライン引数（-local など）を使ってください。

# Discord の Incoming Webhook URL。未設定の場合は Discord へ通知しません。
DISCORD_WEBHOOK_URL=

# Slack の Incoming Webhook URL。未設定の場合は Slack へ通知しません。
SLACK_WEBHOOK_URL=

# ログの保持日数（当日を含む）。既定値は 30。0 を指定すると削除しません。
LOG_RETENTION_DAYS=30

# ローカルのサンプルファイル（./testdata/*.json）を使用するかどうか。既定値は false。
# ここで指定すると USE_LOCAL_SAMPLE=true go run . が効かなくなるため、既定ではコメントアウトしています。
#USE_LOCAL_SAMPLE=false
